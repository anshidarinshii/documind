# Google Gemini API key, used for generating chunk/query embeddings (embeddings.py)
GEMINI_API_KEY=your-gemini-api-key

# Groq API key, used for LLM answer generation (generation.py)
GROQ_API_KEY=your-groq-api-key

# MongoDB connection string, used for vector chunk storage (vector_store.py)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=your-mongodb-connection-string
